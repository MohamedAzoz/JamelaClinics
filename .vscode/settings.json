{
  "css.lint.unknownAtRules": "ignore",

  "scss.lint.unknownAtRules": "ignore",

  "files.associations": {
    "*.css": "tailwindcss"
  },

  "tailwindCSS.classAttributes": [
    "class",

    "className",

    "ngClass",

    "[ngClass]",

    "[class]",

    "class:list"
  ],

  "tailwindCSS.experimental.classRegex": ["class:list"],
  "github.gitProtocol": "ssh",
  "git.repositoryScanIgnoredFolders": ["node_modules", "dist", ".angular"]
}
